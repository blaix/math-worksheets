port module Components.Equations exposing (component, Model, Msg, Props)

import Prettynice.Component exposing (Component)
import Transmutable.Html as H exposing (Html, Attribute)
import Transmutable.Html.Attributes as A
import Transmutable.Html.Events as E
import Random
import Set


component : Component Props Model Msg
component =
    { init = init
    , update = update
    , subscriptions = subscriptions
    , view = view
    }


-- MODEL


type alias Props =
    { seed : Int
    , count : Int
    }


type alias Model =
    { seed : Int
    , count : Int
    , minConstant : Int
    , maxConstant : Int
    , answerSide : SideOption
    , variableSide : SideOption
    , operationsHead : Operation
    , operationsTail : Array Operation
    }


type SideOption
    = OnlyLeft
    | OnlyRight
    | Both


type WhereVar
    = First
    | Second


type AnswerSide
    = Left
    | Right


type Operation
    = Add
    | Subtract
    | Multiply


defaultMinConstant : Int
defaultMinConstant =
    2


defaultMaxConstant : Int
defaultMaxConstant =
    9


{-| Possible values for variable names.
-}
varNames : Array String
varNames =
    "abcdefghijkmnpqrstuvwxyz"
        |> String.split ""


init : Props -> { model : Model, command : Cmd Msg }
init props =
    { model = 
        { seed = props.seed
        , count = props.count
        , minConstant = defaultMinConstant
        , maxConstant = defaultMaxConstant
        , answerSide = OnlyRight
        , variableSide = OnlyLeft
        , operationsHead = Add
        , operationsTail = []
        }
    , command = Cmd.none
    }


-- UPDATE


type Msg
    = Refresh
    | More
    | Less
    | Print
    | ChangedVariableSide String
    | ChangedAnswerSide String
    | ChangedMinConstant String
    | ChangedMaxConstant String
    | AddChecked Bool
    | SubtractChecked Bool
    | MultiplyChecked Bool


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        Refresh ->
            { model = { model | seed = model.seed + model.count + 1 }
            , command = Cmd.none
            }

        More ->
            { model = { model | count = model.count + 1 }
            , command = Cmd.none
            }

        Less ->
            let
                newCount =
                    if model.count < 1 then
                        0
                    else
                        model.count - 1
            in
            { model = { model | count = newCount }
            , command = Cmd.none
            }

        Print ->
            { model = model
            , command = print {}
            }

        ChangedVariableSide selected ->
            { model = 
                { model 
                    | variableSide = 
                        stringToSideOption selected
                }
            , command = Cmd.none
            }

        ChangedAnswerSide selected ->
            { model = 
                { model 
                    | answerSide = 
                        stringToSideOption selected
                }
            , command = Cmd.none
            }

        AddChecked checked ->
            { model =
                if checked then
                    addOperation Add model
                else
                    removeOperation Add model
            , command = 
                Cmd.none
            }

        SubtractChecked checked ->
            { model =
                if checked then
                    addOperation Subtract model
                else
                    removeOperation Subtract model
            , command = 
                Cmd.none
            }

        MultiplyChecked checked ->
            { model =
                if checked then
                    addOperation Multiply model
                else
                    removeOperation Multiply model
            , command = 
                Cmd.none
            }

        ChangedMinConstant n ->
            { model =
                { model
                    | minConstant =
                        n
                            |> String.toInt
                            |> Maybe.withDefault defaultMinConstant
                }
            , command =
                Cmd.none
            }

        ChangedMaxConstant n ->
            { model =
                { model
                    | maxConstant =
                        n
                            |> String.toInt
                            |> Maybe.withDefault defaultMaxConstant
                }
            , command =
                Cmd.none
            }


addOperation : Operation -> Model -> Model
addOperation operation model =
    let
        operations =
            ([ model.operationsHead ] ++ model.operationsTail)
                |> Array.keepIf (\op -> op /= operation)
                |> Array.pushLast operation
    in
    setOperations operations model


removeOperation : Operation -> Model -> Model
removeOperation operation model =
    let
        operations =
            ([ model.operationsHead ] ++ model.operationsTail)
                |> Array.keepIf (\op -> op /= operation)
    in
    setOperations operations model


setOperations : Array Operation -> Model -> Model
setOperations operations model =
    { model
        | operationsHead =
            when Array.takeFirst 1 operations is
                [ head ] ->
                    head

                _ ->
                    Add
        , operationsTail =
            Array.dropFirst 1 operations
    }


stringToSideOption : String -> SideOption
stringToSideOption string =
    when string is
        "Left" -> OnlyLeft
        "Right" -> OnlyRight
        "Both" -> Both
        _ -> OnlyLeft


port print : {} -> Cmd msg


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


-- VIEW


view : Model -> Html Msg
view model =
    H.div []
        [ H.div [ A.class "no-print" ] 
            [ H.button [ E.onClick Refresh ] [ H.text "Refresh" ]
            , H.button [ E.onClick More ] [ H.text "More" ]
            , H.button [ E.onClick Less ] [ H.text "Less" ]
            , H.button [ E.onClick Print ] [ H.text "Print" ]
            ]
        , H.div [ A.class "no-print" ] 
            [ H.label []
                [ H.text "Variable side: " 
                , H.select
                    [ E.onInput ChangedVariableSide ]
                    [ H.option [ A.selected (model.variableSide == OnlyLeft) ] [ H.text "Left" ]
                    , H.option [ A.selected (model.variableSide == OnlyRight) ] [ H.text "Right" ]
                    , H.option [ A.selected (model.variableSide == Both) ] [ H.text "Both" ]
                    ]
                ] 
            ]
        , H.div [ A.class "no-print" ] 
            [ H.label []
                [ H.text "Answer side: " 
                , H.select
                    [ E.onInput ChangedAnswerSide ]
                    [ H.option [ A.selected (model.answerSide == OnlyLeft) ] [ H.text "Left" ]
                    , H.option [ A.selected (model.answerSide == OnlyRight) ] [ H.text "Right" ]
                    , H.option [ A.selected (model.answerSide == Both) ] [ H.text "Both" ]
                    ]
                ] 
            ]
        , H.div [ A.class "no-print" ] 
            [ H.div []
                [ H.text "Operations: " 
                , H.label []
                    [ H.input
                        [ A.type_ "checkbox"
                        , A.checked (hasOperation Add model)
                        , E.onCheck AddChecked
                        ]
                        []
                    , H.text "Add "
                    ]
                , H.label []
                    [ H.input
                        [ A.type_ "checkbox"
                        , A.checked (hasOperation Subtract model)
                        , E.onCheck SubtractChecked
                        ]
                        []
                    , H.text "Subtract "
                    ]
                , H.label []
                    [ H.input
                        [ A.type_ "checkbox"
                        , A.checked (hasOperation Multiply model)
                        , E.onCheck MultiplyChecked
                        ]
                        []
                    , H.text "Multiply "
                    ]
                ] 
            ]
        , H.div [ A.class "no-print" ]
            [ H.label []
                [ H.text "Min constant: "
                , H.input
                    [ A.type_ "number"
                    , A.style "width" "100px"
                    , A.value (String.fromInt model.minConstant)
                    , E.onInput ChangedMinConstant
                    ]
                    []
                ]
            , H.text " "
            , H.label []
                [ H.text "Max constant: "
                , H.input
                    [ A.type_ "number"
                    , A.style "width" "100px"
                    , A.value (String.fromInt model.maxConstant)
                    , E.onInput ChangedMaxConstant
                    ]
                    []
                ]
            ]
        , Array.range 0 model.count 
            |> Array.map (\i -> viewRandomEquation ({model | seed = model.seed + i}))
            |> H.div []
        ]


hasOperation : Operation -> Model -> Bool
hasOperation operation model =
    ([ model.operationsHead ] ++ model.operationsTail)
        |> Array.member operation


viewRandomEquation : Model -> Html Msg
viewRandomEquation model =
    let
        whereVarPool =
            when model.variableSide is
                OnlyLeft ->
                    { head = First, tail = [] }

                OnlyRight ->
                    { head = Second, tail = [] }

                Both ->
                    { head = First, tail = [ Second ] }

        answerSidePool =
            when model.answerSide is
                OnlyLeft ->
                    { head = Left, tail = [] }

                OnlyRight ->
                    { head = Right, tail = [] }

                Both ->
                    { head = Left, tail = [ Right ] }

        seed0 =
            Random.initialSeed model.seed

        { value = value1, seed = seed1 } = 
            Random.step (Random.int model.minConstant model.maxConstant) seed0

        { value = value2, seed = seed2 } = 
            Random.step (Random.int model.minConstant model.maxConstant ) seed1

        { value = whereVar, seed = seed3 } =
            Random.step (Random.uniform whereVarPool.head whereVarPool.tail) seed2

        { value = answerSide, seed = seed4 } =
            Random.step (Random.uniform answerSidePool.head answerSidePool.tail) seed3

        { value = operation, seed = seed5 } =
            Random.step (Random.uniform model.operationsHead model.operationsTail) seed4

        { value = varName } =
            Random.step
                ( Random.int 0 ((Array.length varNames) - 1)
                    |> Random.map
                        ( \i -> 
                            Array.get i varNames
                                |> Maybe.withDefault "x"
                        )
                )
                seed2

        values =
            if value1 > value2 then
                { left = value1
                , right = value2
                }

            else
                { left = value2
                , right = value1
                }

        answer =
            String.fromInt <|
                when operation is
                    Add -> 
                        values.left + values.right       

                    Subtract -> 
                        values.left - values.right

                    Multiply ->
                        values.left * values.right

        operationSymbol =
            when operation is
                Add -> 
                    " + "

                Subtract -> 
                    " - "

                Multiply -> 
                    when whereVar is
                        First ->
                            " • "

                        Second ->
                            ""
         
        expression =
            when whereVar is
                First ->
                    varName ++ operationSymbol ++ (String.fromInt values.right)
            
                Second ->
                    (String.fromInt values.left) ++ operationSymbol ++ varName

        equation =
            when answerSide is
                Left ->
                    answer ++ " = " ++ expression

                Right ->
                    expression ++ " = " ++ answer
    in
    H.p [] [ H.text equation ]


